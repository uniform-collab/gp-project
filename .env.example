# Uniform project, and the key of a service account with the Developer role on it
# (team page → Security → Service Accounts).
# Used by the app and by the `uniform:*` scripts, which `dev` and `build` also run.
UNIFORM_PROJECT_ID=
UNIFORM_API_KEY=

# Must match `secret=` in the project's Preview URL
# (Uniform → Settings → Preview): http://localhost:3000/api/preview?secret=<value>
UNIFORM_PREVIEW_SECRET=
